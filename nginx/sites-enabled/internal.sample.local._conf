server {
    listen 80;
    server_name internal.sample.local;
    
    location /insider-ui {
        proxy_pass http://localhost:2000/insider-ui;
    }

    location /insider-cdn {
        proxy_pass http://localhost:2200/insider-cdn;
    }

    location /api/tdc-api {
        proxy_pass http://localhost:2400/tdc-api;
    }

    location /api/tdc-devops {
        proxy_pass http://localhost:2600/tdc-devops;
    }

    location /api/tdc-backend {
        proxy_pass http://localhost:2800/tdc-backend;
    }

    location /api/tdc-db {
        proxy_pass http://localhost:3000/tdc-db;
    }

    location /api/tdc-frontend {
        proxy_pass http://localhost:3200/tdc-frontend;
    }

    location /api/tdc-design-system {
        proxy_pass http://localhost:3400/tdc-design-system;
    }

    location /api/auth-gate {
        proxy_pass http://localhost:3800/api/auth-gate;
    }

    location /api/merchant-admin {
        proxy_pass http://localhost:9900/api/merchant-admin;
    }

    location /api/irms {
        proxy_pass http://localhost:4000/api/irms;
    }
}