        "crypto-browserify": "^3.12.0",
        "sass-resources-loader": "^2.2.5",
        "react-aria-components": "^1.17.0",
        "prism-react-renderer": "^2.4.1",
        "react-json-view": "^1.21.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^5.3.4"
    },
    "dependencies": {
