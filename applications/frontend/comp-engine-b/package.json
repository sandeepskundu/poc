        "dotenv": "^16.3.1",
        "es6-promise": "4.2.8",
        "express": "^4.18.2",
        "express-xss-sanitizer": "^1.1.6",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "process": "^0.11.10",
        "request": "^2.88.2",
