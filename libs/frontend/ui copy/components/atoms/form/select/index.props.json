{
    "storybook":{
        "parameters":{
            "layout":"centered",
            "docs": {
                "description": {
                    "component": "An input component is a controlled or uncontrolled field used to capture user input such as text, numbers, email, passwords, etc."
                }
            }
          
        },
        "tags": ["autodocs"]
    },
    "props":{
        "open":{ 
            "type":"bool",
            "description":"By default select box option should be open or not",
            "defaultValue":false
        },
        "multiple":{
            "type":"bool",
            "description":"Is select box is multi selectable",
            "defaultValue":false
        },

        "searchable":{
            "type":"bool",
            "description":"Is select box is searchable",
            "defaultValue":true
        },
        "allowDeselect":{
            "type":"bool",
            "description":"This means that if user click on selected option this should gets deselects",
            "defaultValue":true
        },
        "closeOnSelect":{
            "type":"bool",
            "description":"This means that options list box should get closed automatically. Post option selection",
            "defaultValue":true
        },
        "selectedIcon":{
            "type":"object",
            "description":"This defines which icon/text should display for selected option.",
            "defaultValue":{
                "enabled":true,
                "content":null,
                "placement":"end",
                "iconConfig":{
                    "type":"font",
                    "icon":{
                        "size":20,
                        "name":"check"
                    }
                }
            }
        },
        "filter":{
            "type":"object",
            "description":"This defines the filtering behavior that should be applied when the user enters text into the input field.",
            "defaultValue":{
                "callback":null,
                "logics":{
                    "0":{
                        "mode":"includes",
                        "keys":["label"]
                    }
                },
                "config":{
                    "match":"lowercase"
                }
            }
        },
        "keymap": { 
            "type":"object",
            "description":"This configuration determines which field is used to display the option label and which field acts as the unique identifier for the selected option.",
            "defaultValue":{
                "label":"label",
		        "selection":"value"
            }
        },
        "content":{ 
            "type":"object",
            "description":"This contains all display-related text content used across different use cases.",
            "defaultValue":{
                "noResult":{
                    "default":"No selectable items found",
                    "orginial":"No selectable items found",
                    "filtered":"No results found"
                }
            }
        },
        "templates":{ 
            "type":"object",
            "description":"This contains all template rendering methods used across different sections.",
            "defaultValue":{
                "list":null,
                "trigger":null,
                "noResult":{
                    "default":null,
                    "orginial":null,
                    "filtered":null
                }
            }
        },
        "dropdown": { 
            "type":"object",
            "description":"This contains all dropdown-related configurations such as position, toggle behavior, arrow visibility, mode, and other display settings.",
            "defaultValue":{
                "controls":{
                    "arrow":false,
                    "mode":"react",
                    "toggle":"click",
                    "position":"bottom-right"
                }
            }
        },
        "input": { 
            "type":"object",
            "description":"This contains all input field-related configurations such as label, name, placeholder, and other display settings.",
            "defaultValue":{
                "label":"",
                "name":"",
                "type":"",
                "error":"",
                "eye":false,
                "minLength":2,
                "maxlength":100,
                "description":"",
                "placeholder":"",
                "defaultValue":"",
                "debounceDelay":500,
                "prefix":false,
                "suffix":false,
                "invalid":false,
                "disabled":false,
                "required":false,
                "readonly":false,
                "clearable":true
            }
        },
        "callback":{
            "type":"object",
            "description":"This contains all callback method configurations for the input field and select box.",
            "defaultValue":{
                "onOpen":null,
		        "onClose":null,
                "onSelect":null,
                "onRemove":null,
                "onChange":{
                    "afterFilter":null,
                    "beforeFilter":null,
                    "afterListUpdate":null
                },
                "input":{
                    "onCut":null,
                    "onCopy":null,
                    "onBlur":null,
                    "onEnter":null,
                    "onFocus":null,
                    "onInput":null,
                    "onPaste":null,
                    "onSelect":null,
                    "onKeyUp":null,
                    "onKeyDown":null,
                    "onChange":null,
                    "onChangeEnd":null,
                    "onChangeStart":null,
                    "onBeforeInput":null,
                    "onCompositionEnd":null,
                    "onCompositionStart":null,
                    "onCompositionUpdate":null
                }
            }
        },
        "dsTheme": { 
            "type":"object",
            "description":"This contains all DS theme configurations for different sections of the select box, such as the input field, dropdown, list box, and related components.",
            "defaultValue":{
                "input":{
                    "icons":{},
                    "description":{}
                },
                "dropdown":{
                    "wrapper":{},
                    "content":{
                        "radius":"6",
                        "shadow":"md",
                        "border":"c00103",
                        "background":"c00000"
                    },
                    "noResult":{
                        "default":{
                            "color":"c00306",
                            "font__d__size":"xs"
                        },
                        "orginial":{},
                        "filtered":{}
                    }
                },
                "listBox":{
                    "boxWrapper":{
                        "color":"",
                        "border":"",
                        "shadow":"",
                        "background":""
                    },
                    "item":{
                        "default":{
                            "end":{
                                "color":"c12307"
                            },
                            "after":{},
                            "start":{},
                            "before":{},
                            "center":{},
                            "wrapper":{
                                "color":"c00108",
                                "hcolor":"c00109",
                                "background":"c00000",
                                "hbackground":"c00102"
                            }
                        },
                        "selected":{
                            "end":{
                                "color":"c00506"
                            },
                            "after":{},
                            "start":{},
                            "before":{},
                            "center":{},
                            "wrapper":{
                                "background":"c00101"
                            }
                        }
                    }
                }
            }
        },

